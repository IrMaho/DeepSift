{
  "name": "deepsift",
  "version": "1.0.3",
  "description": "Semantic Codebase Search \u2014 MCP Server + CLI Bridge for any IDE",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "deepsift": "dist/cli/cli-entry.js"
  },
  "scripts": {
    "build": "tsc && node scripts/build-zig.js && tsx scripts/generate-docs.ts && node scripts/build-directive.js",
    "build:release": "node scripts/build-release.js",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "dev": "tsx src/server.ts",
    "dev:cli": "tsx src/cli/cli-entry.ts",
    "start": "node dist/server.js",
    "start:cli": "node dist/cli/cli-entry.js",
    "test": "vitest run",
    "benchmark:quality": "npx tsx src/benchmark/search-quality-benchmark.ts"
  },
  "keywords": [
    "mcp",
    "semantic-search",
    "deepsift"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "node-gyp": "^12.4.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^0.1.53",
    "@xenova/transformers": "^2.17.2",
    "async-mutex": "^0.5.0",
    "ignore": "^7.0.6",
    "node-addon-api": "^8.9.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8",
    "zod": "^4.4.3"
  },
  "files": [
    "dist",
    "templates",
    "native/core-zig/build.zig",
    "native/core-zig/src",
    "bin"
  ]
}
